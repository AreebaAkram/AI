   "source": [
    "import cv2\n",
    "\n",
    "image =cv2.imread(\"a.png\")\n",
    "\n",
    "start_point = (450,450)\n",
    "radius = 200\n",
    "\n",
    "color =(0,255,0)\n",
    "thickness = 2\n",
    "image_with_line = cv2.circle(image, start_point, radius, color, thickness)\n",
    "\n",
    "cv2.imshow(\"Image with Line\", image_with_line)\n",
    "\n",
    "cv2.waitKey(0)\n",
    "cv2.destroyAllWindows()"
   ]
