    "kernel_size = (21, 21)\n",
    "blurred_img = cv2.GaussianBlur(image, kernel_size, 0)\n",
    "cv2.imshow(\"blurred_img\", blurred_img)\n",
    "cv2.imshow(\"actual img\" , image)\n",
    "cv2.waitKey(0)\n",
    "cv2.destroyAllWindows()"
