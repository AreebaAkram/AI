    "import numpy as np\n",
    "image = cv2.imread(\"a.png\", 0)\n",
    "threshold_value = 117\n",
    "max_val = 255\n",
    "binary_img = cv2.threshold(image, threshold_value, max_val, cv2.THRESH_BINARY)\n",
    "cv2.imshow('Image', image)\n",
    "cv2.waitKey(0)\n",
    "cv2.destroyAllWindows()"
